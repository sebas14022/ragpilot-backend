# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
SUPABASE_ANON_KEY=your_anon_key

# ---- Google Gemini (embeddings; also serves as fallback LLM) ----
# Free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding output dimension. Must match the vector(N) column in the schema
# (currently vector(1536); do not change unless you migrate the column).
EMBEDDING_DIM=1536

# ---- Groq (primary LLM) ----
# The SAME model drives both branches of /v1/compare so the comparison isolates
# retrieval. Key at https://console.groq.com/keys. If left empty, the backend
# falls back to GEMINI_MODEL above.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Document budget ----
# The full-doc baseline stuffs the whole selected corpus into a single prompt,
# so each document (and the sum of the selected ones) must stay under the LLM
# request limit (~6K tokens == ~24K chars). Returns 422 if exceeded.
MAX_DOCUMENT_CHARS=24000

# ---- RAG behaviour ----
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
GROUNDED_HIGH=0.72
GROUNDED_MEDIUM=0.48
GROUNDEDNESS_LLM_FALLBACK=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Storage bucket ----
STORAGE_BUCKET=ragpilot-docs
